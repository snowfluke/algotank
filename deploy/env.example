# Settings of the game server in production. Copy to /etc/algotank/env (mode 0640, owner
# root, group algotank). systemd reads it through EnvironmentFile=, and
# deploy/ecosystem.config.cjs reads it for pm2. apps/server/src/config.ts is the source of
# every variable. Write each line as NAME=value, without quotes and without spaces around =.

# The port of the server. Caddy sends requests to this port, so deploy/Caddyfile names it too.
PORT=3000

# Listen on the local interface only, so every visitor must come through Caddy.
HOST=127.0.0.1

# The data folder: arenas, accounts, play styles, "My tank", league, champions and chat.
# systemd makes it from StateDirectory=algotank in deploy/algotank.service.
DATA_DIR=/var/lib/algotank

# The sign-in cookie goes over HTTPS only. Visitors reach the site through Cloudflare over HTTPS.
COOKIE_SECURE=1

# Read the visitor's address from X-Forwarded-For and the host from X-Forwarded-Host.
# Turn it on only because Caddy replaces both headers (see deploy/Caddyfile).
# Without it, every visitor has Caddy's address and the sign-in limits apply to everyone together.
TRUST_PROXY=1

# A private or presenter arena with no activity for this many hours is removed with its chat.
ARENA_TTL_HOURS=24

# The most practice arenas at once.
PUBLIC_ARENA_MAX=20

# The time zone whose calendar days and months the monthly league follows (IANA name).
LEAGUE_TIME_ZONE=Asia/Jakarta

# The accounts that may open /admin/metrics, the usage numbers (comma-separated emails).
# Register the account with this email before you share the site.
# ADMIN_EMAILS=you@example.org

# The bearer token of GET /metrics, the server health for a monitor (docs/deployment/06-monitoring.md).
# Make one with: openssl rand -hex 24
# METRICS_TOKEN=

# Email for the verification and password-reset codes (docs/deployment/10-mail.md). Without
# SMTP_HOST the server sends no email: accounts stay unverified, the server refuses an arena for
# players with a verified email, and a forgotten password is reset with
# apps/server/scripts/reset-password.ts. Example for a Gmail account with an app password (it
# sends about 500 emails a day):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=the 16 letters of the app password, without spaces
# MAIL_FROM=AlgoTank <you@gmail.com>

# STATIC_DIR is not set: the server serves apps/web/dist of its own release, which
# deploy/release.sh builds.

# PUBLIC_TIME_DIVISOR and LEAGUE_SHORT_DAYS must not be in this file. They shorten the public
# arenas' turns and waits and the league's days for scripted test runs, and production must use
# the real times.
